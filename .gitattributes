# Integration tests compare tool output against these fixtures line by line,
# splitting on "\n". The tool always writes LF, so a fixture checked out with
# CRLF leaves a trailing "\r" on every line and the comparison fails.
tests/data/** text eol=lf

# Spreadsheet fixtures are binary and must not be line-ending converted.
tests/data/**/*.xlsx binary

# Scripts run through their shebang line. Checked out with CRLF, the trailing
# "\r" becomes part of the interpreter name and the kernel finds no such
# program.
*.sh text eol=lf
py/acb-tools text eol=lf
py/colorize-table text eol=lf
www/scripts/npm text eol=lf
